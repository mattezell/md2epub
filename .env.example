# Copy to .env and fill in. Node reads this file at startup; it is gitignored.

# --- Server ---------------------------------------------------------------
PORT=8787
# 127.0.0.1 keeps the portal on this machine. Use 0.0.0.0 to expose it on the
# LAN or a tailnet, and put an authenticating proxy in front if you do.
HOST=127.0.0.1

# --- Email ----------------------------------------------------------------
# Leave SMTP_HOST unset to run download only: the portal disables its email
# controls and /api/email answers 503.
#
# MAIL_TRANSPORT=log writes the message and the attachment to .mail-outbox
# instead of sending, which is the way to try the email path without
# credentials.
#MAIL_TRANSPORT=log

#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=someone@example.com
#SMTP_PASS=an-app-password
# TLS is required by default on port 587 (implicit TLS on 465). Set this only
# for a relay on localhost that speaks plaintext.
#SMTP_ALLOW_PLAINTEXT=false
#MAIL_FROM=md2epub <someone@example.com>
#MAIL_REPLY_TO=
# Connect, greeting and socket timeouts, in milliseconds.
#SMTP_TIMEOUT_MS=20000
# Implicit TLS. Defaults to true on port 465 and false elsewhere.
#SMTP_SECURE=

# Where MAIL_TRANSPORT=log writes its messages.
#MAIL_OUTBOX=.mail-outbox

# Cloudflare Workers only: Workers cannot open SMTP connections, so the Worker
# build sends over HTTP with Resend. Set these as secrets, not here.
#RESEND_API_KEY=

# Your Send to Kindle address, used by `md2epub <file> --kindle`. Find it in
# Amazon: Manage Your Content and Devices, Preferences, Personal Document
# Settings. MAIL_FROM must also be on that page's Approved Personal Document
# E-mail List or Amazon silently drops the message.
#KINDLE_ADDRESS=you@kindle.com

# Comma separated. Entries are either a full address or a @domain suffix.
# Leave empty to allow any recipient. Set this before exposing the portal.
#MAIL_ALLOWED_RECIPIENTS=me@example.com,@kindle.com

# Per client address, per hour.
MAIL_RATE_PER_HOUR=20

# --- Conversion limits ----------------------------------------------------
MAX_MARKDOWN_BYTES=8388608
MAX_COVER_BYTES=12582912
MAX_IMAGE_BYTES=12582912

# Off by default: turning it on lets a pasted document make the server fetch
# arbitrary URLs. Private, loopback, link local and CGNAT/tailnet addresses are
# refused either way.
EMBED_REMOTE_IMAGES=false

# --- Diagrams -------------------------------------------------------------
# Render mermaid diagrams to images. Needs `npm run diagrams:install` first.
# Every conversion then spawns a headless browser, so think before enabling it
# on a portal that anyone can reach.
#RENDER_DIAGRAMS=false

# Only needed if Chrome is somewhere unusual, or you want a specific one.
# Used for diagrams and for turning the drawn cover into a PNG.
#CHROME_PATH=/opt/google/chrome/chrome

# The drawn cover is rasterised to PNG because Kindle will not display an SVG
# cover. Set this to false to skip it and keep the SVG.
#RASTERIZE_COVER=true

# Where rendered diagrams are cached (default ~/.cache/md2epub).
#MD2EPUB_CACHE_DIR=

# Re-read public/ on every request, for editing the front end.
#MD2EPUB_DEV=1

# Read a different env file instead of ./.env.
#MD2EPUB_ENV_FILE=
