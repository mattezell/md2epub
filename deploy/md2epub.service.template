# md2epub as a systemd service.
#
# This is a template. Fill it in and install it with:
#   npm run service:print | sudo tee /etc/systemd/system/md2epub.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now md2epub
#
# Bind loopback (HOST=127.0.0.1 in .env) and put a reverse proxy in front:
# md2epub has no authentication of its own, so anything that can reach it can
# convert and, if email is configured, send.

[Unit]
Description=md2epub - Markdown to EPUB portal
Documentation=__REPO__
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__DIR__
# PORT, HOST and the mail settings come from the gitignored .env, which the
# server reads itself at startup.
ExecStart=__NODE__ __DIR__/src/server.js
Restart=on-failure
RestartSec=5

# Diagram rendering spawns a headless Chrome per conversion, which needs a
# writable temp space and a little room.
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
