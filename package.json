{
  "name": "md2epub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paste or upload Markdown, get a valid EPUB 3 back: download it or have it emailed.",
  "main": "src/core/index.js",
  "exports": {
    ".": "./src/core/index.js",
    "./app": "./src/app.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "cli": "node src/cli.js",
    "validate": "node scripts/validate.mjs",
    "epubcheck:install": "node scripts/install-epubcheck.mjs",
    "kindle": "node src/cli.js --kindle",
    "diagrams:install": "node scripts/install-mermaid.mjs",
    "skill:install": "node scripts/install-skill.mjs",
    "service:print": "node scripts/print-service.mjs",
    "mail:check": "node scripts/mail-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@mozilla/readability": "^0.6.0",
    "entities": "^8.1.0",
    "fflate": "^0.8.2",
    "hono": "^4.13.14",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "markdown-it": "^15.0.3",
    "nodemailer": "^10.2.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  },
  "bin": {
    "md2epub": "src/cli.js"
  },
  "license": "Apache-2.0",
  "author": "Matt Ezell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattezell/md2epub.git"
  },
  "keywords": [
    "epub",
    "markdown",
    "kindle",
    "ebook",
    "epub3",
    "mermaid",
    "readability"
  ],
  "homepage": "https://github.com/mattezell/md2epub#readme",
  "bugs": {
    "url": "https://github.com/mattezell/md2epub/issues"
  }
}
